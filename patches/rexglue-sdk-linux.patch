+/**
+ * @file        tests/unit/main.cpp
+ * @brief       Unit test entry point
+ *
+ * @copyright   Copyright (c) 2026 Tom Clay <tomc@tctechstuff.com>
+ *              All rights reserved.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include <catch2/catch_session.hpp>
+
+#include <cstdlib>
+
+// The runtime's static teardown is not safe to run after the test session
+// (some global registries are destroyed twice through the test link). Exit
+// directly once Catch2 has reported the result - this also keeps
+// catch_discover_tests' `--list-tests` invocation from crashing.
+int main(int argc, char** argv) {
+  const int result = Catch::Session().run(argc, argv);
+  std::_Exit(result);
+}
diff --git a/thirdparty/CMakeLists.txt b/thirdparty/CMakeLists.txt
index f2dbe79..fa08d50 100644
--- a/thirdparty/CMakeLists.txt
+++ b/thirdparty/CMakeLists.txt
@@ -176,6 +176,14 @@ set(SNAPPY_INSTALL ON CACHE BOOL "" FORCE)
 add_subdirectory(snappy)
 target_compile_options(snappy PRIVATE -w)
 
+# Snappy's MemCopy64 uses AVX intrinsics whenever __AVX__ is defined, but its
+# generated config.h reports no BMI2/CRC32 and therefore skips <immintrin.h>.
+# -march=x86-64-v3 (used by the SDK and port presets) triggers that path, so
+# compile Snappy without AVX and let it use the portable copy.
+if(UNIX AND NOT APPLE AND CMAKE_SYSTEM_PROCESSOR MATCHES "x86_64|AMD64")
+    target_compile_options(snappy PRIVATE -mno-avx)
+endif()
+
