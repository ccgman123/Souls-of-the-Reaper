diff --git a/include/rex/input/slot_arbiter.h b/include/rex/input/slot_arbiter.h
new file mode 100644
index 0000000..6b9aa23
--- /dev/null
+++ b/include/rex/input/slot_arbiter.h
@@ -0,0 +1,66 @@
+/**
+ ******************************************************************************
+ * Souls of the Reaper - shared input player-slot arbiter.
+ ******************************************************************************
+ *
+ * The keyboard/mouse driver and the SDL controller driver both claim a guest
+ * xam user_index on their first real input, so whoever acts first at the title
+ * screen becomes player 1. Slots are released when an SDL controller is
+ * disconnected, allowing a reconnected pad (or the keyboard) to take it again.
+ *
+ * This header was missing from the published SDK patch; it is reconstructed
+ * from the two call sites (ClaimNextSlot / ReleaseSlot).
+ */
+
+#pragma once
+
+#include <atomic>
+#include <bit>
+#include <cstdint>
+#include <optional>
+
+namespace rex::input {
+
+class SlotArbiter {
+ public:
+  static constexpr uint32_t kSlotCount = 4;
+
+  // Returns the lowest-numbered free slot and marks it claimed, or nullopt if
+  // all four slots are taken. Thread-safe; callers serialize their own state.
+  static std::optional<uint32_t> ClaimNextSlot() {
+    uint32_t claimed = claimed_.load(std::memory_order_relaxed);
+    for (;;) {
+      const uint32_t free_mask = ~claimed & kAllSlotsMask;
+      if (!free_mask) {
+        return std::nullopt;
+      }
+      const uint32_t slot = std::countr_zero(free_mask);
+      if (claimed_.compare_exchange_weak(claimed, claimed | (uint32_t(1) << slot),
+                                         std::memory_order_acq_rel,
+                                         std::memory_order_relaxed)) {
+        return slot;
+      }
+    }
+  }
+
+  // Frees a slot previously returned by ClaimNextSlot. Out-of-range values are
+  // ignored.
+  static void ReleaseSlot(uint32_t slot) {
+    if (slot >= kSlotCount) {
+      return;
+    }
+    claimed_.fetch_and(~(uint32_t(1) << slot), std::memory_order_release);
+  }
+
+  static bool IsClaimed(uint32_t slot) {
+    return slot < kSlotCount &&
+           (claimed_.load(std::memory_order_acquire) & (uint32_t(1) << slot)) != 0;
+  }
+
+ private:
+  static constexpr uint32_t kAllSlotsMask = (uint32_t(1) << kSlotCount) - 1;
+
+  static inline std::atomic<uint32_t> claimed_{0};
+};
+
+}  // namespace rex::input
