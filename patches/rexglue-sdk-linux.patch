+# Test discovery runs the runtime-linked binary at build time; runtime logging
+# writes to stdout and corrupts Catch2's JSON discovery output, so tests are
+# invoked directly instead. Build the target, then run
+# rexglue-sdk/out/linux-amd64/unit_tests with an optional test-name filter.
+# include(Catch)
+# catch_discover_tests(unit_tests
+#     TEST_PREFIX "unit."
+#     PROPERTIES
+#         LABELS "unit"
